# Google OAuth (Web application client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8766/connect/callback

# App
APP_BASE_URL=http://127.0.0.1:8766
SESSION_SECRET=change-me-to-a-long-random-string

# Local http:// only — never set in production
OAUTHLIB_INSECURE_TRANSPORT=1
