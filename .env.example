# Google OAuth (Web application client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8766/connect/callback

# App
APP_BASE_URL=http://127.0.0.1:8766
SESSION_SECRET=change-me-to-a-long-random-string
# Sessions are stored server-side (encrypted) — default .data/sessions.sqlite3
# SESSION_DB_PATH=.data/sessions.sqlite3
# Optional dedicated Fernet key (else derived from SESSION_SECRET):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SESSION_ENCRYPTION_KEY=

# Local http:// only — never set in production
OAUTHLIB_INSECURE_TRANSPORT=1
